<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.myapplication.HomeFragment"
        android:label="일정" />

    <fragment
        android:id="@+id/assignmentFragment"
        android:name="com.example.myapplication.AssignmentRegisterFragment"
        android:label="과제" />

    <fragment
        android:id="@+id/notesFragment"
        android:name="com.example.myapplication.NotesFragment"
        android:label="AI요약">

        <action
            android:id="@+id/action_notesFragment_to_manageFilesFragment"
            app:destination="@id/manageFilesFragment" />
    </fragment>

    <navigation
        android:id="@+id/analytics_graph"
        app:startDestination="@id/analyticsFragment">

        <fragment
            android:id="@+id/analyticsFragment"
            android:name="com.example.myapplication.AnalyticsFragment"
            android:label="학습 분석">

            <action
                android:id="@+id/action_analyticsFragment_to_quizLearnedFragment"
                app:destination="@id/quizLearnedFragment" />
        </fragment>

        <fragment
            android:id="@+id/quizLearnedFragment"
            android:name="com.example.myapplication.QuizLearnedFragment"
            android:label="학습된 퀴즈" />
    </navigation>

    <fragment
        android:id="@+id/teamProjectFragment"
        android:name="com.example.myapplication.TeamProjectFragment"
        android:label="Team Project" />

    <fragment
        android:id="@+id/manageFilesFragment"
        android:name="com.example.myapplication.ManageFilesFragment"
        android:label="요약 파일 관리" />


</navigation>