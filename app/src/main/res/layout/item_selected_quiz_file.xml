<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:paddingHorizontal="8dp"
    android:paddingVertical="10dp">

    <CheckBox
        android:id="@+id/checkFile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true" />

    <ImageView
        android:id="@+id/ivFileThumbnail"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:contentDescription="TXT 파일 아이콘"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_edit" />

    <TextView
        android:id="@+id/tvSelectedFileName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="파일명.txt"
        android:textColor="@android:color/black"
        android:textSize="14sp" />

    <ImageButton
        android:id="@+id/btnRemoveFile"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="파일 제거"
        android:padding="6dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel" />

</LinearLayout>