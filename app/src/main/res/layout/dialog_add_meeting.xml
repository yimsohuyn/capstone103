<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background_primary">

    <TextView
        android:id="@+id/tvMeetingDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="회의 일정 추가"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="날짜"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btnSelectMeetingDate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="날짜 선택" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="시간"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btnSelectMeetingTime"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="시간 선택" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="메모 (선택)"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/editMeetingMemo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="예: 발표 순서 정하기"
        android:minLines="2"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:background="@drawable/rounded_box"
        android:padding="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnCancelMeetingDialog"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="취소" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnSaveMeetingDialog"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="저장"
            android:textColor="@color/icon_white"
            android:backgroundTint="@color/point_assignment" />
    </LinearLayout>

</LinearLayout>