<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 상단바 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/settingTopBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 뒤로가기 버튼 -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="뒤로가기"
            app:tint="@color/icon_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 타이틀 -->
        <TextView
            android:id="@+id/settingTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="설정"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 상단 사용자 박스 -->
    <LinearLayout
        android:id="@+id/userBox"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:layout_margin="16dp"
        android:padding="20dp"
        android:orientation="horizontal"
        android:background="@drawable/rounded_bg_gray"
        app:layout_constraintTop_toBottomOf="@id/settingTopBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 사람 아이콘 -->
        <ImageView
            android:id="@+id/userIcon"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/ic_user"
            android:tint="@color/icon_primary"
            android:layout_gravity="center_vertical" />

        <!-- 구글 아이디 텍스트 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="20dp">

            <TextView
                android:id="@+id/tvGoogleEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="아이디"
                android:textSize="16sp"
                android:textColor="@color/text_primary" />

            <View
                android:layout_width="180dp"
                android:layout_height="1dp"
                android:background="@color/underline"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>


    <!-- 메뉴 리스트 영역 -->
    <LinearLayout
        android:id="@+id/settingMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/userBox"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 메뉴 1 : 다크모드 -->
        <LinearLayout
            android:id="@+id/settingInfo1"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:gravity="center_vertical"
            android:background="@color/background_primary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            >

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_moon"
                android:tint="@color/accent_teal" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="다크모드"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:layout_marginStart="12dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchDarkMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:useMaterialThemeColors="false"
                app:thumbTint="@color/switch_thumb"
                app:trackTint="@color/switch_track"/>

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

        <!-- 메뉴 2 : 정보 -->
        <LinearLayout
            android:id="@+id/settingInfo2"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:gravity="center_vertical"
            android:background="@color/background_primary"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_info"
                android:layout_marginTop="3dp"
                android:tint="@color/icon_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="정보"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

        <!-- 로그아웃 -->
        <LinearLayout
            android:id="@+id/settingLogout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:gravity="center_vertical"
            android:background="@color/background_primary"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="로그아웃"
                android:textSize="17sp"
                android:textColor="@color/accent_red_dark" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>