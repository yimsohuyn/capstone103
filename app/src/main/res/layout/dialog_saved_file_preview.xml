<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="22dp">

    <TextView
        android:id="@+id/tvPreviewFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="파일명.txt"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tvPreviewSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="저장된 요약 파일 미리보기"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/divider_light" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:maxHeight="420dp"
        android:background="@drawable/bg_dialog_result_box"
        android:padding="16dp"
        android:fadeScrollbars="false"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tvPreviewContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:textIsSelectable="true" />
    </ScrollView>

    <TextView
        android:id="@+id/btnClosePreview"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_dialog_secondary_button"
        android:gravity="center"
        android:text="닫기"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>