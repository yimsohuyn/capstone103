<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F5F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. 팀원 섹션 -->
        <TextView
            android:id="@+id/textTeamTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="팀원"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">


            <TextView
                android:id="@+id/textTeamDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="팀원 이름을 추가해 주세요."
                android:textColor="#666666"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnAddMember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ 추가" />

            <Button
                android:id="@+id/btnTeamInvite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="팀원 초대"
                android:padding="10dp"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/memberListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="12dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/textEmptyMembers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="등록된 팀원이 없습니다."
                android:textColor="#999999"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

        <!-- 2. 진행 상황 섹션 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="진행률"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="진행률: 0% (0/5)"
            android:textColor="#555555"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100"
            android:progress="0"
            android:progressTint="#3A82F7"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/checklistContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="12dp"
            android:elevation="2dp">

            <CheckBox
                android:id="@+id/checkTopic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="주제 선정 완료" />

            <CheckBox
                android:id="@+id/checkResearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="자료 조사 진행" />

            <CheckBox
                android:id="@+id/checkMeeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="팀 회의 진행" />

            <CheckBox
                android:id="@+id/checkSlides"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="발표 자료(PPT) 작성" />

            <CheckBox
                android:id="@+id/checkPractice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="발표 연습 완료" />
        </LinearLayout>

        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

        <!-- 3. 회의 일정 섹션 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="팀 회의"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnAddMeeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ 일정 추가"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/meetingListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="12dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/textEmptyMeetings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="등록된 회의 일정이 없습니다."
                android:textColor="#999999"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

        <!-- 4. 파일 업로드 & 공유 섹션 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="프로젝트 파일"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnAddFile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ 파일 업로드"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/fileListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="12dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/textEmptyFiles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="등록된 파일이 없습니다."
                android:textColor="#999999"
                android:textSize="13sp" />
        </LinearLayout>


    </LinearLayout>
</ScrollView>
