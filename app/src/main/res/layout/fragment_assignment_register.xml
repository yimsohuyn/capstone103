<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/background_secondary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/background_primary"
        android:elevation="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- 🔹 상단 바: 뒤로가기 + 가운데 제목 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <!-- 뒤로가기 버튼 -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_back"
                app:tint="@color/icon_primary"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="뒤로가기" />

            <!-- 가운데 제목 -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="과제 등록"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_centerInParent="true" />

        </RelativeLayout>

        <!-- 과제 제목 -->
        <EditText
            android:id="@+id/editTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="제목"
            android:background="@android:color/transparent"
            android:padding="12dp"
            android:textSize="16sp" />

        <!-- 설명 -->
        <EditText
            android:id="@+id/editDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="설명"
            android:background="@android:color/transparent"
            android:padding="12dp"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:textSize="16sp"
            android:layout_marginTop="10dp" />

        <!-- 마감일 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="마감일"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:id="@+id/dueDateLayout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@drawable/rounded_box">

            <TextView
                android:id="@+id/textDueDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="마감일 선택"
                android:textColor="@color/text_primary" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_calendar"
                android:tint="@color/text_primary"/>
        </LinearLayout>

        <!-- 담당자 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="담당자 (선택)"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:id="@+id/assigneeLayout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@drawable/rounded_box">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_user" />

            <TextView
                android:id="@+id/textAssignee"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="담당자 선택"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- 파일 첨부 -->
        <LinearLayout
            android:id="@+id/attachLayout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_attach"
                android:tint="@color/text_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="파일 첨부"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- 과제 유형 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="과제 유형"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="20dp" />

        <Spinner
            android:id="@+id/spinnerType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/rounded_box" />

        <!-- 제출 버튼 -->
        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="등록"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:textColor="@color/icon_white"
            android:backgroundTint="@color/point_assignment" />

    </LinearLayout>

</ScrollView>
