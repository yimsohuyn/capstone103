<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- 상단바 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/manageFilesTopBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/background_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <!-- 뒤로가기 버튼 -->
    <ImageButton
        android:id="@+id/btnBackManageFiles"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_back"
        android:contentDescription="뒤로가기"
        app:tint="@color/icon_primary"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 타이틀 -->
    <TextView
        android:id="@+id/manageFilesTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="요약 파일 관리"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center" />

</androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 구분선 -->
    <View
    android:id="@+id/dividerManageFiles"
    android:layout_width="0dp"
    android:layout_height="1dp"
    android:background="@color/divider"
    app:layout_constraintTop_toBottomOf="@id/manageFilesTopBar"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <!-- 파일이 없을 때 안내 텍스트 -->
    <TextView
    android:id="@+id/tvEmptyFiles"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text="저장된 파일이 없습니다."
    android:textColor="@color/text_secondary"
    android:textSize="15sp"
    android:gravity="center"
    android:paddingTop="60dp"
    android:visibility="gone"
    app:layout_constraintTop_toBottomOf="@id/dividerManageFiles"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <!-- 파일 목록 (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/rvManagedFiles"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_marginTop="8dp"
    android:paddingHorizontal="8dp"
    app:layout_constraintTop_toBottomOf="@id/dividerManageFiles"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>