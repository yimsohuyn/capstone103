<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeFragment">

    <!-- 상단 메뉴 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topMenu"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@color/background_home_gradient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Study With Me"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.7" />

        <ImageView
            android:id="@+id/settingIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_setting"
            android:tint="@color/text_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.7" />

        <ImageView
            android:id="@+id/bellIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="34dp"
            android:src="@drawable/ic_bell"
            android:tint="@color/text_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.7" />

        <ImageView
            android:id="@+id/searchIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="64dp"
            android:src="@drawable/ic_search"
            android:tint="@color/text_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.7" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 달력 -->
    <!-- 달력 : MaterialCalendarView 사용 -->


    <!-- 오늘 일정 영역 -->
    <CalendarView
        android:id="@+id/calendarView"
        android:layout_width="0dp"
        android:layout_height="350dp"
        android:background="@color/background"
        android:theme="@style/CalendarViewStyle"
        android:selectedWeekBackgroundColor="@color/calendar_selected_date"
        android:focusedMonthDateColor="@color/calendar_text"
        android:unfocusedMonthDateColor="@color/calendar_weekend"
        android:weekSeparatorLineColor="@color/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topMenu" />

    <LinearLayout
        android:id="@+id/todayScheduleArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/calendarView"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/todayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="오늘 일정"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

<!--        <Button-->
<!--            android:id="@+id/syncCalendarButton"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="구글 캘린더 연동"-->
<!--            android:layout_margin="16dp"-->
<!--            android:backgroundTint="#3A82F7"-->
<!--            android:textColor="@android:color/white" />-->


        <TextView
            android:id="@+id/calendarStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="구글 계정과 연결하면 일정이 자동으로 업데이트됩니다."
            android:textColor="@color/accent_red"
            android:paddingBottom="12dp" />


        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="상태 메시지 표시 영역"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:paddingBottom="8dp"
            android:paddingTop="8dp"/>

        <LinearLayout
            android:id="@+id/calendarEventsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:textColor="@color/text_secondary">

            <TextView
                android:id="@+id/emptyEventsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="연동된 일정이 없습니다."
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <!-- 플러스 버튼 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_add"
        android:contentDescription="Add Schedule"
        app:tint="@color/icon_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        app:backgroundTint="@color/point_assignment"
        app:maxImageSize="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
