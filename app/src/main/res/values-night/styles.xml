<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 기본 앱 테마 -->
    <style name="Theme.AndroidTest" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorSecondary">@color/teal_200</item>
    </style>

    <!-- 선택된 탭 글씨 -->
    <style name="BottomNavTextActive" parent="@style/TextAppearance.Material3.BodyMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>

        <!-- 글씨 위로 -->
        <item name="android:paddingTop">-6dp</item>
    </style>

    <!-- 비선택 탭 글씨 -->
    <style name="BottomNavTextInactive" parent="@style/TextAppearance.Material3.BodyMedium">
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">14sp</item>

        <!-- 비선택 글씨도 동일하게 위로 -->
        <item name="android:paddingTop">-6dp</item>
    </style>

    <style name="FAB_Round">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!--    tap mode-->
    <style name="TabTextSelected">
        <item name="android:textStyle">bold</item>
    </style>

    <!--    alert dialog-->
    <style name="MyDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/onSecondary</item>
        <item name="colorSurface">@color/dialog_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonStyle</item>
    </style>

    <style name="DialogButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/onSecondary</item>
    </style>

    <!-- CalendarView 커스텀 스타일 (Dark mode) -->
    <style name="CalendarViewStyle">
        <item name="android:textColor">@color/calendar_text</item>
        <item name="android:textColorPrimary">@color/calendar_text</item>
        <item name="android:colorControlActivated">@color/calendar_selected_date</item>
    </style>

    <!-- DatePicker 커스텀 스타일 (Dark mode) -->
    <style name="DatePickerStyle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:colorControlActivated">@color/accent_blue</item>
        <item name="colorAccent">@color/accent_blue</item>
    </style>

</resources>
